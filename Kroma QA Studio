    function handleSynonymsCheck(inputId, text) {
      const drawer = document.getElementById(`syn_drawer_${inputId}`);
      const chipsContainer = document.getElementById(`chips_container_${inputId}`);
      if (!drawer || !chipsContainer) return;

      if (!text.trim()) {
        drawer.style.display = 'none';
        chipsContainer.innerHTML = '';
        return;
      }

      const words = text.toLowerCase().match(/\\b[a-záéíóúñ0-9_]+\\b/g) || [];
      const detectedSynonyms = [];

      words.forEach(w => {
        if (QA_SYNONYMS_DB[w]) {
          QA_SYNONYMS_DB[w].forEach(syn => {
            detectedSynonyms.push({ original: w, synonym: syn });
          });
        }
      });

      if (detectedSynonyms.length > 0) {
        drawer.style.display = 'block';
        chipsContainer.innerHTML = '';
        
        const uniqueKeys = new Set();
        detectedSynonyms.forEach(item => {
          const key = `${item.original}->${item.synonym}`;
          if (!uniqueKeys.has(key)) {
            uniqueKeys.add(key);
            const chip = document.createElement('span');
            chip.className = 'syn-chip';
            chip.textContent = `${item.original} ➜ ${item.synonym}`;
            chip.onclick = () => replaceWordWithSynonym(inputId, item.original, item.synonym);
            chipsContainer.appendChild(chip);
          }
        });
      } else {
        drawer.style.display = 'none';
        chipsContainer.innerHTML = '';
      }
    }

    function replaceWordWithSynonym(inputId, targetWord, newWord) {
      const inputEl = document.getElementById(inputId);
      if (!inputEl) return;

      const regex = new RegExp(`\\\\b${targetWord}\\\\b`, 'i');
      inputEl.value = inputEl.value.replace(regex, newWord);

      handleSynonymsCheck(inputId, inputEl.value);
      inputEl.dispatchEvent(new Event('input'));
      showToast(`Reemplazado: "${targetWord}" por "${newWord}"`);
    }

    function updateLivePreview(modId) {
      const container = document.getElementById(`view-${modId}`);
      if (!container) return;

      const cards = container.querySelectorAll('.field-row');
      let htmlLines = '<ul>';
      let mdLines = [];

      cards.forEach(card => {
        const name = card.getAttribute('data-field-name');
        const type = card.getAttribute('data-type');
        const input = card.querySelector('.form-input');
        let val = input ? input.value.trim() : '';

        if (type === 'inherited_build') {
          val = globalSessionBuild || 'No definida';
        } else if (type === 'steps_default') {
          val = val ? `1 loggeate 2 da aceptar 3 ${val}` : '1 loggeate 2 da aceptar 3 ...';
        } else if (type === 'comment_lorem') {
          val = val ? `${val} - Lorem ipsum dolor sit amet, consectetur adipiscing elit.` : '...';
        }

        if (type === 'select') {
          htmlLines += `<li><strong>${name}:</strong> <strong>${val || '(sin selección)'}</strong></li>`;
          mdLines.push(`* **${name}:** **${val || ''}**`);
        } else {
          htmlLines += `<li><strong>${name}:</strong> ${val || '(vacío)'}</li>`;
          mdLines.push(`* **${name}:** ${val || ''}`);
        }
      });

      htmlLines += '</ul>';
      lastCompiledMarkdown[modId] = mdLines.join('\\n');

      const liveBox = document.getElementById(`live_stream_${modId}`);
      if (liveBox) {
        liveBox.innerHTML = htmlLines;
      }
    }

