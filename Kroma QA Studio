<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kroma QA Studio - Workstation de Calidad y Registro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --brand-amber: #FFAA00;
      --brand-amber-hover: #ff9400;
      --brand-amber-glow: rgba(255, 170, 0, 0.28);
      --brand-amber-subtle: rgba(255, 170, 0, 0.08);
      --bg-canvas: #f8f8f8;
      --card-bg: #FFFFFF;
      --charcoal-deep: #343434;
      --charcoal-light: #525252;
      --charcoal-muted: #757575;
      --border: #e6e6e6;
      --border-focus: #FFAA00;
      --code-bg: #fafafa;
      --success: #2e7d32;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --shadow-subtle: 0 4px 20px rgba(52, 52, 52, 0.06);
      --shadow-hover: 0 8px 30px rgba(52, 52, 52, 0.1);
      --shadow-glow: 0 0 0 4px rgba(255, 170, 0, 0.22);
      --transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--charcoal-deep);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Global Header */
    .global-header {
      width: 100%;
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(52, 52, 52, 0.04);
      backdrop-filter: blur(8px);
    }

    .nav-container {
      max-width: 1160px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      flex-direction: column;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0 10px 0;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo-badge {
      width: 32px;
      height: 32px;
      background: var(--charcoal-deep);
      color: var(--brand-amber);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.1rem;
      box-shadow: 0 2px 8px rgba(255, 170, 0, 0.35);
      transition: var(--transition);
    }

    .brand-logo-badge:hover {
      transform: rotate(5deg) scale(1.05);
    }

    .brand-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--charcoal-deep);
      letter-spacing: -0.5px;
    }

    .brand-name span {
      color: var(--brand-amber);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-icon-custom {
      background: transparent;
      border: 1.5px solid var(--border);
      color: var(--charcoal-deep);
      border-radius: var(--radius-full);
      padding: 7px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: var(--transition);
    }

    .btn-icon-custom:hover {
      border-color: var(--brand-amber);
      background: var(--brand-amber-subtle);
      transform: translateY(-1px);
    }

    /* Barra de Sesión Maestra */
    .session-build-bar {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 10px 16px;
      background: var(--brand-amber-subtle);
      border: 1.5px dashed var(--brand-amber);
      border-radius: var(--radius-md);
      margin-bottom: 12px;
      transition: var(--transition);
    }

    .session-build-bar:focus-within {
      background: #fff;
      box-shadow: var(--shadow-glow);
    }

    .session-build-bar label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--charcoal-deep);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .session-build-input {
      flex: 1;
      border: none;
      border-bottom: 1.5px solid rgba(52, 52, 52, 0.2);
      background: transparent;
      padding: 4px 0;
      font-size: 0.95rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--charcoal-deep);
      outline: none;
      transition: var(--transition);
    }

    .session-build-input:focus {
      border-bottom-color: var(--brand-amber);
    }

    /* Tabs de Navegación */
    .tabs-nav {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      border-top: 1px solid var(--border);
      padding-top: 4px;
    }

    .tab-item {
      padding: 12px 18px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--charcoal-muted);
      text-decoration: none;
      white-space: nowrap;
      border-bottom: 3px solid transparent;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      cursor: pointer;
      transition: var(--transition);
    }

    .tab-item:hover {
      color: var(--charcoal-deep);
      background-color: rgba(52, 52, 52, 0.03);
    }

    .tab-item.active {
      color: var(--charcoal-deep);
      border-bottom: 3px solid var(--brand-amber);
    }

    /* Contenedor Principal */
    .main-wrapper {
      width: 100%;
      max-width: 1160px;
      padding: 28px 20px 56px 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .split-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 920px) {
      .split-layout {
        grid-template-columns: 1fr;
      }
    }

    /* Tarjetas */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      padding: 26px 28px;
      box-shadow: var(--shadow-subtle);
      transition: var(--transition);
    }

    .card:hover {
      box-shadow: var(--shadow-hover);
    }

    .header-card {
      border-top: 6px solid var(--brand-amber);
      margin-bottom: 18px;
    }

    .header-card h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--charcoal-deep);
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    .header-card p {
      color: var(--charcoal-muted);
      font-size: 0.92rem;
    }

    /* Secciones Agrupadas (Chunking) */
    .form-group-section {
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      background: #ffffff;
      margin-bottom: 16px;
      transition: var(--transition);
      position: relative;
    }

    .form-group-section:focus-within {
      border-color: var(--brand-amber);
      box-shadow: 0 4px 16px rgba(255, 170, 0, 0.12);
      transform: translateY(-2px);
    }

    .group-legend {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--charcoal-deep);
      margin-bottom: 16px;
    }

    .step-badge {
      background: var(--brand-amber);
      color: var(--charcoal-deep);
      border-radius: var(--radius-full);
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 800;
    }

    .field-row {
      margin-bottom: 16px;
    }

    .field-row:last-child {
      margin-bottom: 0;
    }

    .label-container {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 6px;
    }

    .label-container label {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--charcoal-deep);
    }

    .required-dot {
      color: #e53935;
      font-weight: bold;
    }

    .badge-help {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: var(--radius-full);
      background: #f0f0f0;
      color: var(--charcoal-muted);
      font-size: 0.7rem;
      font-weight: 700;
      cursor: help;
      position: relative;
      transition: var(--transition);
    }

    .badge-help:hover {
      background: var(--brand-amber);
      color: var(--charcoal-deep);
    }

    .tooltip {
      visibility: hidden;
      opacity: 0;
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--charcoal-deep);
      color: #fff;
      font-size: 0.75rem;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      width: 240px;
      text-align: center;
      line-height: 1.35;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      transition: var(--transition);
      z-index: 20;
      pointer-events: none;
    }

    .tooltip::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      margin-left: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: var(--charcoal-deep) transparent transparent transparent;
    }

    .badge-help:hover .tooltip {
      visibility: visible;
      opacity: 1;
    }

    /* Inputs y Efecto Glow */
    .g-input {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 0.92rem;
      background: #fafafa;
      color: var(--charcoal-deep);
      outline: none;
      transition: var(--transition);
    }

    .g-input:focus {
      background: #ffffff;
      border-color: var(--border-focus);
      box-shadow: var(--shadow-glow);
    }

    /* Sinónimos */
    .synonym-drawer {
      margin-top: 10px;
      padding: 12px 14px;
      background: var(--brand-amber-subtle);
      border: 1px dashed var(--brand-amber);
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
      display: none;
      animation: fadeIn 0.25s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .synonym-drawer-title {
      font-weight: 700;
      color: var(--charcoal-deep);
      margin-bottom: 8px;
    }

    .chips-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .syn-chip {
      background: #fff;
      color: var(--charcoal-deep);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      border: 1.5px solid rgba(255, 170, 0, 0.4);
      transition: var(--transition);
      box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    }

    .syn-chip:hover {
      border-color: var(--brand-amber);
      background: var(--brand-amber);
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(255, 170, 0, 0.3);
    }

    .grid-3-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    @media (max-width: 600px) {
      .grid-3-fields {
        grid-template-columns: 1fr;
      }
    }

    .g-select {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      font-size: 0.88rem;
      background: #fafafa;
      color: var(--charcoal-deep);
      outline: none;
      cursor: pointer;
      transition: var(--transition);
    }

    .g-select:focus {
      background: #fff;
      border-color: var(--brand-amber);
      box-shadow: var(--shadow-glow);
    }

    .readonly-inherited {
      background: #f5f5f5;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      color: var(--charcoal-deep);
      font-weight: 600;
    }

    .steps-visual-box {
      background: #f8f8f8;
      border: 1px dashed var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      margin-bottom: 8px;
      font-size: 0.82rem;
      color: var(--charcoal-muted);
      line-height: 1.5;
    }

    /* Live Preview Panel */
    .live-preview-card {
      border-top: 6px solid var(--brand-amber);
      position: sticky;
      top: 140px;
    }

    .live-preview-card h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--charcoal-deep);
    }

    .status-pill {
      font-size: 0.72rem;
      background: var(--brand-amber-subtle);
      color: #b26a00;
      border: 1px solid rgba(255, 170, 0, 0.4);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .live-stream-box {
      background: #fafafa;
      border: 1px solid var(--border);
      border-left: 4px solid var(--brand-amber);
      border-radius: var(--radius-md);
      padding: 16px;
      font-size: 0.88rem;
      line-height: 1.65;
      min-height: 240px;
      max-height: 480px;
      overflow-y: auto;
      color: var(--charcoal-deep);
    }

    .live-stream-box ul {
      list-style-type: disc;
      padding-left: 20px;
    }

    .live-stream-box li {
      margin-bottom: 8px;
    }

    .live-stream-box strong {
      color: var(--charcoal-deep);
      font-weight: 700;
    }

    /* Botones */
    .btn-submit {
      background: var(--brand-amber);
      color: var(--charcoal-deep);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 12px 24px;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      box-shadow: 0 3px 12px rgba(255, 170, 0, 0.35);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
    }

    .btn-submit:hover {
      background: var(--brand-amber-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(255, 170, 0, 0.45);
    }

    .btn-clear {
      background: transparent;
      color: var(--charcoal-muted);
      border: none;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .btn-clear:hover {
      color: var(--charcoal-deep);
      background: rgba(52, 52, 52, 0.05);
    }

    .actions-bar {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .btn-action {
      background: #ffffff;
      border: 1.5px solid var(--border);
      color: var(--charcoal-deep);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-action:hover {
      border-color: var(--charcoal-deep);
      transform: translateY(-1px);
    }

    .btn-action-primary {
      background: var(--charcoal-deep);
      color: #ffffff;
      border-color: var(--charcoal-deep);
    }

    .btn-action-primary:hover {
      background: #1f1f1f;
      border-color: #1f1f1f;
    }

    /* Modal & Toast */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(52, 52, 52, 0.65);
      z-index: 200;
      justify-content: center;
      align-items: center;
      padding: 20px;
      backdrop-filter: blur(4px);
    }

    .modal-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      max-width: 520px;
      width: 100%;
      padding: 28px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.25);
    }

    .toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--charcoal-deep);
      color: #fff;
      padding: 12px 24px;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 500;
      box-shadow: 0 6px 20px rgba(0,0,0,0.25);
      z-index: 300;
      opacity: 0;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(255,255,255,0.1);
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .view-content {
      display: none;
      width: 100%;
    }

    .view-content.active-view {
      display: block;
    }
  </style>
</head>
<body>

  <!-- Header Global -->
  <header class="global-header">
    <div class="nav-container">
      <div class="top-bar">
        <div class="brand-group">
          <div class="brand-logo-badge">K</div>
          <div class="brand-name">Kroma <span>QA Studio</span></div>
        </div>
        <div class="header-actions">
          <button class="btn-icon-custom" onclick="toggleAbstract(true)">📖 Abstract & Guía</button>
        </div>
      </div>

      <!-- Barra de Build Global -->
      <div class="session-build-bar">
        <label for="globalSessionBuild">📌 Build Maestra de Sesión:</label>
        <input type="text" id="globalSessionBuild" class="session-build-input" placeholder="Ej. v2.4.102-build.99482-hotfix_RC3" oninput="updateGlobalBuild(this.value)">
      </div>

      <nav class="tabs-nav" id="tabsNavContainer"></nav>
    </div>
  </header>

  <!-- Viewport Principal -->
  <main class="main-wrapper" id="mainAppContainer"></main>

  <!-- Modal Abstract -->
  <div class="modal-overlay" id="abstractModal" onclick="if(event.target===this) toggleAbstract(false)">
    <div class="modal-card">
      <h3 style="font-family:'Space Grotesk'; font-size:1.3rem; color:var(--charcoal-deep); margin-bottom:10px;">
        Kroma QA Studio - Identidad & UX Operativa
      </h3>
      <p style="font-size:0.92rem; line-height:1.6; color:var(--charcoal-light); margin-bottom:20px;">
        Diseñado bajo la paleta de alto contraste <strong>#FFFFFF</strong>, <strong>#FFAA00</strong> (Ámbar Activo) y <strong>#343434</strong> (Carbón Profundo). Optimizado con micro-interacciones suaves, halo de atención <em>Glow Focus</em> y persistencia local sin servidor.
      </p>
      <div style="text-align: right;">
        <button class="btn-submit" onclick="toggleAbstract(false)">Entendido</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toastBox">Acción realizada</div>

  <script>
    const QA_SYNONYMS_DB = {
      "error": ["fallo", "anomalía", "defecto", "bug", "excepción", "falla", "glitch"],
      "fallo": ["error", "defecto", "bloqueo", "anomalía", "cierre forzado", "bug"],
      "bloqueo": ["congelamiento", "freeze", "hang", "cierre", "cuelgue", "pantallazo"],
      "cerrar": ["terminar", "abortar", "crash", "cierre abrupto", "detener"],
      "caida": ["crash", "cierre forzado", "desconexión", "interrupción"],
      "caída": ["crash", "cierre forzado", "desconexión", "interrupción"],
      "pantalla": ["interfaz", "display", "vista", "overlay", "UI", "HUD"],
      "lento": ["lag", "retraso", "baja tasa de fps", "latencia", "stuttering"],
      "audio": ["sonido", "efectos de audio", "SFX", "pista", "desincronización de audio"],
      "boton": ["control", "pulsador", "CTA", "disparador", "switch"],
      "botón": ["control", "pulsador", "CTA", "disparador", "switch"],
      "guardar": ["salvar", "persistir", "almacenar", "sync"],
      "login": ["inicio de sesión", "autenticación", "acceso", "sign-in"],
      "crash": ["freeze", "force close", "unexpected termination", "hang", "unhandled exception"],
      "freeze": ["hang", "lockup", "unresponsive state", "crash", "stutter"],
      "bug": ["defect", "glitch", "issue", "anomaly", "failure"],
      "glitch": ["rendering artifact", "visual bug", "visual flicker", "jitter"],
      "lag": ["latency", "stuttering", "frame drop", "input delay"],
      "failure": ["defect", "error", "breakage", "crash"]
    };

    const ALLOWED_BUILDS = [
      'v2.4.102-build.99482-hotfix_RC3 (Actual Staging)',
      'v2.4.101-build.98320-release (Producción)',
      'v2.4.100-build.97110-main (Base)',
      'v2.5.000-alpha.1042-nightly (Experimental)'
    ];

    const APP_MODULES = [
      {
        id: 'ticket1',
        label: 'Ticket 1',
        title: 'Ticket 1: Reporte de Incidencia',
        desc: 'Completa los campos. Las micro-animaciones y el panel de previsualización guían el llenado.',
        groups: [
          {
            title: '1. Contexto & Origen del Fallo',
