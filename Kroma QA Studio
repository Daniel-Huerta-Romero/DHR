    function processMatrix() {
      const raw = document.getElementById('matrix_input').value.trim();
      if (!raw) {
        showToast('Pega datos de Excel para procesar');
        return;
      }

      const rows = raw.split(/\\r?\\n/).slice(0, 500);
      const matriz = {
        NS: { VF: 0, VO: 0, OP: 0, total: 0 },
        XB: { VF: 0, VO: 0, OP: 0, total: 0 },
        PS: { VF: 0, VO: 0, OP: 0, total: 0 }
      };
      const colTotals = { VF: 0, VO: 0, OP: 0, grandTotal: 0 };
      let validCount = 0;

      rows.forEach(line => {
        const tokens = line.trim().split(/[\\t,;\\s]+/).filter(Boolean);
        if (tokens.length >= 2) {
          let plat = tokens[0].toUpperCase();
          let status = tokens[1].toUpperCase();

          if (plat === 'PS5' || plat === 'PS4' || plat === 'PLAYSTATION') plat = 'PS';
          if (plat === 'XBOX' || plat === 'XBS' || plat === 'XSX' || plat === 'XB1') plat = 'XB';
          if (plat === 'SWITCH' || plat === 'NSW') plat = 'NS';

          if (matriz[plat] && matriz[plat][status] !== undefined) {
            matriz[plat][status]++;
            matriz[plat].total++;
            colTotals[status]++;
            colTotals.grandTotal++;
            validCount++;
          }
        }
      });

      const tableHtml = `
