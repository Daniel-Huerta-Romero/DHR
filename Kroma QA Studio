              <th style="padding:10px; border:1px solid var(--border); font-family:'Space Grotesk';">OP</th>
              <th style="padding:10px; border:1px solid var(--border); font-family:'Space Grotesk'; font-weight:700;">Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:10px; border:1px solid var(--border); text-align:left; font-weight:600;">NS (Switch)</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.NS.VF}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.NS.VO}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.NS.OP}</td>
              <td style="padding:10px; border:1px solid var(--border); font-weight:700;">${matriz.NS.total}</td>
            </tr>
            <tr>
              <td style="padding:10px; border:1px solid var(--border); text-align:left; font-weight:600;">PS (PlayStation)</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.PS.VF}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.PS.VO}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.PS.OP}</td>
              <td style="padding:10px; border:1px solid var(--border); font-weight:700;">${matriz.PS.total}</td>
            </tr>
            <tr>
              <td style="padding:10px; border:1px solid var(--border); text-align:left; font-weight:600;">XB (Xbox)</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.XB.VF}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.XB.VO}</td>
              <td style="padding:10px; border:1px solid var(--border);">${matriz.XB.OP}</td>
              <td style="padding:10px; border:1px solid var(--border); font-weight:700;">${matriz.XB.total}</td>
            </tr>
            <tr style="border-top:2px solid var(--brand-amber); font-weight:700; background:var(--brand-amber-subtle);">
              <td style="padding:10px; border:1px solid var(--border); text-align:left;">TOTAL</td>
              <td style="padding:10px; border:1px solid var(--border);">${colTotals.VF}</td>
              <td style="padding:10px; border:1px solid var(--border);">${colTotals.VO}</td>
              <td style="padding:10px; border:1px solid var(--border);">${colTotals.OP}</td>
              <td style="padding:10px; border:1px solid var(--border); color:#b26a00; font-size:1rem;">${colTotals.grandTotal}</td>
            </tr>
          </tbody>
        </table>
      `;

      document.getElementById('matrix_table_render').innerHTML = tableHtml;

      const mdArray = [
        `* **conteo verify total registros:** ${colTotals.grandTotal}`,
        `* **NS (Nintendo Switch):** VF: ${matriz.NS.VF} | VO: ${matriz.NS.VO} | OP: ${matriz.NS.OP} | **Total:** ${matriz.NS.total}`,
        `* **PS (PlayStation):** VF: ${matriz.PS.VF} | VO: ${matriz.PS.VO} | OP: ${matriz.PS.OP} | **Total:** ${matriz.PS.total}`,
        `* **XB (Xbox):** VF: ${matriz.XB.VF} | VO: ${matriz.XB.VO} | OP: ${matriz.XB.OP} | **Total:** ${matriz.XB.total}`,
        `* **totales por estado:** VF: ${colTotals.VF} | VO: ${colTotals.VO} | OP: ${colTotals.OP}`
      ];

      lastCompiledMarkdown['matrix'] = mdArray.join('\\n');

      let htmlOut = '<ul>';
      mdArray.forEach(l => {
        htmlOut += `<li>${l.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>').replace(/^\\* /, '')}</li>`;
      });
      htmlOut += '</ul>';

      document.getElementById('matrix_markdown_render').innerHTML = htmlOut;
      document.getElementById('matrix_output_card').style.display = 'block';

      showToast('✓ Matriz calculada y sincronizada');
    }

    function clearMatrix() {
      document.getElementById('matrix_input').value = '';
      document.getElementById('matrix_output_card').style.display = 'none';
      document.getElementById('matrix_counter_badge').textContent = '0 filas detectadas';
      saveLocalStorage();
      showToast('Matriz restablecida');
    }

    function copyCompiledMarkdown(key) {
      const text = lastCompiledMarkdown[key];
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        showToast('✓ Markdown copiado al portapapeles');
      });
    }

    function downloadCompiledMD(key) {
      const text = lastCompiledMarkdown[key];
      if (!text) return;
      const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `kroma_report_${key}_${Date.now()}.md`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('✓ Archivo .md exportado a tu carpeta');
    }

    function downloadCompiledTXT(key) {
      const text = lastCompiledMarkdown[key];
      if (!text) return;
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `kroma_report_${key}_${Date.now()}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('✓ Archivo .txt exportado');
    }

    function switchTab(modId) {
      activeTabId = modId;
      localStorage.setItem('qa_active_tab', modId);

      document.querySelectorAll('.tab-item').forEach((tab, index) => {
        tab.classList.toggle('active', APP_MODULES[index].id === modId);
      });

      document.querySelectorAll('.view-content').forEach(view => {
        view.classList.toggle('active-view', view.id === `view-${modId}`);
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function saveLocalStorage() {
      const state = {};
      document.querySelectorAll('.form-input').forEach(input => {
        if (input.id) state[input.id] = input.value;
      });
      const matrixVal = document.getElementById('matrix_input');
      if (matrixVal) state['matrix_input'] = matrixVal.value;
      localStorage.setItem('qa_form_state', JSON.stringify(state));
    }

    function restoreLocalStorage() {
      const raw = localStorage.getItem('qa_form_state');
      if (!raw) return;
      try {
        const state = JSON.parse(raw);
        for (const [id, val] of Object.entries(state)) {
          const el = document.getElementById(id);
          if (el) {
            el.value = val;
            if (el.id === 'ticket1_resumen') {
              handleSynonymsCheck(el.id, el.value);
            }
          }
        }
      } catch(e) {}
    }

    let toastTimeout;
    function showToast(msg) {
      const toast = document.getElementById('toastBox');
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function toggleAbstract(show) {
      document.getElementById('abstractModal').style.display = show ? 'flex' : 'none';
    }

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        if (activeTabId === 'conteo_verify') {
          processMatrix();
        } else {
          finalizeForm(null, activeTabId);
        }
      }
    });

    window.onload = () => {
      initApp();
    };
  </script>
</body>
</html>
